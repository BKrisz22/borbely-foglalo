<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        Kötelező jelszócsere jelzése (például a tulajdonostól kapott kezdőjelszó után).
        Új fájlban, mert a már lefuttatott 001-init.xml-t nem szabad módosítani:
        a Liquibase ellenőrzőösszeget tárol róla.
    -->
    <changeSet id="011-app-user-must-change-password" author="krisztian">
        <addColumn tableName="app_user">
            <column name="must_change_password" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <rollback>
            <dropColumn tableName="app_user" columnName="must_change_password"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
